# /etc/systemd/system/agent-svc@.service —— 业务服务进程的模板单元
#
# 实例名 = <服务>:<环境>:<进程>，如 agent-svc@board:test:server.service。
# 平台启动前把启动规格写到 /var/lib/agent-platform/instances/<实例名>.json（命令、工作目录、
# 配置文件绑定、其他环境配置遮蔽），svcrun 读它并在 bwrap 里 exec 业务进程：
# 进程看到的固定配置路径里永远是这个环境的文件，别的环境的配置读不到。
#
# 业务进程以 svc-runner 身份运行（按实际部署调整，需能读业务目录）；
# 平台用户 agent-svc 通过 polkit 规则管理 agent-svc@*.service（deploy/50-agent-svc.rules）。
[Unit]
Description=agent-platform managed service %i
After=network.target

[Service]
Type=exec
User=svc-runner
Group=svc-runner
Environment=AGENT_INSTANCES_DIR=/var/lib/agent-platform/instances
ExecStart=/opt/agent-platform/venv/bin/python -m agent_platform.services.svcrun %i
KillMode=control-group
TimeoutStopSec=20
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
