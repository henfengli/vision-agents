# ~/.config/systemd/user/agent-platform.service —— systemd --user 单元（deploy/install-user.sh 装）：接口 + 控制台 + worker
# 同机部署：跑在部署线上项目的那个用户下。部署配置是 conf/env/prod.yaml + ~/.config/agent-platform/local.yaml。
# 模型写的代码（项目内核、bash）在 bwrap 沙箱里、各自一个 systemd 用户 scope（agent.slice 下，限内存），看不到真实配置与密钥。
[Unit]
Description=agent-platform
After=network-online.target

[Service]
Slice=agent.slice
Environment=AGENT_ENV=prod
Environment=AGENT_CONF=%h/agent-platform/conf
Environment=AGENT_DATA_DIR=%h/.local/share/agent-platform
# 自己放的 bwrap / git（没有系统包时）放 ~/.local/bin，这里排在最前
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=%h/.config/agent-platform/secrets.env
WorkingDirectory=%h/agent-platform
# 监听地址与 HTTPS 在部署配置的 listen 里（默认 127.0.0.1:8100）
ExecStart=%h/agent-platform/venv/bin/agent-platform serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# 平台进程本身不另设内存上限：和内核、bash 一起受 agent.slice 的总上限约束

[Install]
WantedBy=default.target
