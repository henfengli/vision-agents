# ~/.config/systemd/user/temporal-server.service —— 用户级部署的单机 Temporal（start-dev + SQLite）
# @TEMPORAL@ 由 install-user.sh 换成 temporal 可执行文件的绝对路径
[Unit]
Description=Temporal Server（agent-platform，用户级）

[Service]
ExecStart=@TEMPORAL@ server start-dev --db-filename %h/.local/share/temporal/history.db \
  --ip 127.0.0.1 --port 7233 --ui-port 8233
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
