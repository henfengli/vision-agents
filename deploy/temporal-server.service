[Unit]
Description=Temporal Server (agent-platform durable execution)
After=network.target postgresql.service

[Service]
Type=simple
# 与 agent-platform.service / install.sh 同一运行用户
User=agent-svc
Group=agent-svc
# start-dev 是单进程开发模式：持久层用内嵌 SQLite（--db-filename），
# 不依赖 Postgres；生产建议改为集群模式 + Postgres 持久层（见 README 部署节）
ExecStart=/usr/local/bin/temporal server start-dev \
  --db-filename /var/lib/temporal/history.db \
  --ip 127.0.0.1 --port 7233 --ui-port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/temporal

[Install]
WantedBy=multi-user.target
