# /etc/systemd/system/agent-platform.service —— 接口 + 控制台 + worker（同一进程）
# 权限收口：低权限用户、全盘只读、只有数据目录可写。agent 的 bash 工具继承这些限制，再套一层 bwrap。
[Unit]
Description=agent-platform
After=network.target postgresql.service temporal-server.service

[Service]
User=agent-svc
Group=agent-svc
Environment=AGENT_ENV=prod
Environment=AGENT_CONF=/opt/agent-platform/conf
Environment=AGENT_DATA_DIR=/var/lib/agent-platform
EnvironmentFile=/etc/agent-platform/secrets.env
WorkingDirectory=/opt/agent-platform
ExecStart=/opt/agent-platform/venv/bin/agent-platform serve --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=5

ProtectSystem=strict
# scratch：agent 工作区；assets：沉淀的方法文件；instances：进程启动规格与本地后端日志
ReadWritePaths=/var/lib/agent-platform
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
